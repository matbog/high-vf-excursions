__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# large binary outputs — regenerated by running run.py / scenes.py
experiments/*/results/*.vti
experiments/*/results/*.vtp
experiments/*/paraview/**/*.vti
experiments/*/paraview/**/*.vtp
# per-realization checkpoints (regenerated by run.py)
experiments/*/results/sample_vf_*.npz
experiments/*/results*/sample_vf_*.npz
# very large per-component CSV dumps (regenerated by run.py)
experiments/*/results/raw_winner_components.csv
experiments/*/results*/raw_winner_components.csv

# ParaView session files
*.pvsm

# figures and (small) CSVs ARE committed (documentation depends on them)
# the display_*.png ParaView screenshots inside paraview/ folders are also committed
# to regenerate heavy outputs: mamba run -n rf_explo python run.py in each experiment folder

# scratch / archive — not part of the public release
explorations/

# editors
.vscode/
.idea/
*.swp
