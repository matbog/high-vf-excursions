# Research provenance records byte-level hashes of these Python sources.
# Keep their current LF bytes on Windows and Unix checkouts alike.
src/*.py text eol=lf
experiments/04_margin_tessellation/*.py text eol=lf

# Saved diagnostics hash other saved files, including CSV and JSON inputs.
# Preserve the original bytes; text diffs still work for CSV/JSON/Markdown.
# Recognize preserved CRLF as an end-of-line sequence in whitespace checks.
experiments/04_margin_tessellation/results_saved_q32_sweep/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
experiments/04_margin_tessellation/results_local_films/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
experiments/04_margin_tessellation/results_local_films_refined/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
experiments/04_margin_tessellation/results_local_patches/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
experiments/04_margin_tessellation/results_local_patch_components_refined/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
